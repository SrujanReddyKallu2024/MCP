# ─── AWS Configuration ───
# AWS region where MWAA and EMR Serverless run
AWS_REGION=eu-west-2

# Default environment when 'env' param is omitted (dev/uat/test/prod)
DEFAULT_ENV=dev

# ─── AWS Profiles (per environment — different AWS accounts) ───
# Each env needs its own gimme-aws-creds profile.
# Run: gimme-aws-creds -p <profile> before starting the server.
AWS_PROFILE_DEV=consumersync-dev
AWS_PROFILE_UAT=consumersync-uat
AWS_PROFILE_TEST=consumersync-test
AWS_PROFILE_PROD=consumersync-prod

# Legacy: single profile (used if no per-env vars above are set)
# AWS_PROFILE=consumersync

# ─── MWAA Environments ───
# Set the MWAA environment name for each tier you have access to.
# At least one is required for Airflow tools to work.
# Note: only dev has "consumersyncenv" — rest have "consumersync"
MWAA_ENV_DEV=eec-aws-uk-ms-dev-consumersyncenv-mwaa
MWAA_ENV_UAT=eec-aws-uk-ms-uat-consumersync-mwaa
MWAA_ENV_TEST=eec-aws-uk-ms-tst-consumersync-mwaa
MWAA_ENV_PROD=eec-aws-uk-ms-prod-consumersync-mwaa
MWAA_DEFAULT_ENV=dev

# ─── EMR Serverless (per environment) ───
# S3 bucket and prefix where Spark driver logs are stored
EMR_LOG_BUCKET_DEV=eec-aws-uk-ms-consumersync-dev-logs-bucket
EMR_LOG_BUCKET_UAT=eec-aws-uk-ms-consumersync-uat-logs-bucket
EMR_LOG_BUCKET_TEST=eec-aws-uk-ms-consumersync-tst-logs-bucket
EMR_LOG_BUCKET_PROD=eec-aws-uk-ms-consumersync-prod-logs-bucket
EMR_LOG_PREFIX=spark-logs

# Legacy: single bucket (used if no per-env vars above are set)
# EMR_LOG_BUCKET=eec-aws-uk-ms-consumersync-dev-logs-bucket

# ─── S3 General ───
# No extra config needed. S3 tools use AWS_REGION and the per-env profiles above.
# They can access any bucket the authenticated profile has permissions for.
# Pass env='dev'/'uat'/'test'/'prod' to S3 tools to switch accounts.

# ─── Confluence ───
# Your Confluence server URL and a Personal Access Token (PAT)
# Generate a PAT: Confluence → Profile → Personal Access Tokens → Create
CONFLUENCE_BASE_URL=https://pages.experian.local
CONFLUENCE_PAT=your-personal-access-token
CONFLUENCE_SPACE_KEY=ACTIVATE
CONFLUENCE_ROOT_PAGE_ID=

# ─── Azure DevOps (TFS) ───
# On-prem: https://{server}/tfs/{collection}
# Cloud:   https://dev.azure.com/{organization}
# PAT scopes needed: Work Items (Read), Code (Read)
AZDO_BASE_URL=https://ukfhpapcvt02.uk.experian.local/tfs/DefaultCollection
AZDO_PAT=your-personal-access-token
AZDO_PROJECT=Activate
AZDO_TEAM=Activate Team
