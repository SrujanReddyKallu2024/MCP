# ─── AWS Configuration ───
# AWS region where MWAA and EMR Serverless run
AWS_REGION=eu-west-2
# AWS CLI profile name (run: gimme-aws-creds -p <profile> before starting)
AWS_PROFILE=consumersync

# ─── MWAA Environments ───
# Set the MWAA environment name for each tier you have access to.
# At least one is required for Airflow tools to work.
MWAA_ENV_DEV=your-dev-mwaa-environment-name
MWAA_ENV_TEST=
MWAA_ENV_PROD=
MWAA_DEFAULT_ENV=dev

# ─── EMR Serverless ───
# S3 bucket and prefix where Spark driver logs are stored
EMR_LOG_BUCKET=your-emr-logs-bucket
EMR_LOG_PREFIX=spark-logs

# ─── Confluence ───
# Your Confluence server URL and a Personal Access Token (PAT)
# Generate a PAT: Confluence → Profile → Personal Access Tokens → Create
CONFLUENCE_BASE_URL=https://pages.experian.local
CONFLUENCE_PAT=your-personal-access-token
CONFLUENCE_SPACE_KEY=ACTIVATE
CONFLUENCE_ROOT_PAGE_ID=

